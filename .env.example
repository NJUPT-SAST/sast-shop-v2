DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sast_shop_v2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_REDIRECT_URL=

# Tencent Cloud COS (product image object storage)
# COS_BUCKET_URL 格式: https://<bucket>-<appid>.cos.<region>.myqcloud.com
# COS_CDN_BASE_URL 为公有读 CDN 域名，上传成功后返回的图片地址基于它拼接
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET_URL=
COS_CDN_BASE_URL=

APP_ENV=development
SAST_SHOP_IDGEN_WORKER_ID=-1

USER_SERVICE_URL=http://localhost
USER_SERVICE_PORT=1323
CATALOG_SERVICE_URL=http://localhost
CATALOG_SERVICE_PORT=1324
PAYMENT_SERVICE_URL=http://localhost
PAYMENT_SERVICE_PORT=1325
SPOT_SERVICE_URL=http://localhost
SPOT_SERVICE_PORT=1326
ERRAND_SERVICE_URL=http://localhost
ERRAND_SERVICE_PORT=1327

# West Pocket: use the same 32+ character random token in user/payment/pocket services.
WEST_POCKET_SERVICE_URL=http://localhost
WEST_POCKET_SERVICE_PORT=1328
WEST_POCKET_INTERNAL_TOKEN=
# Independent random 32-byte key encoded as base64; protects QR snapshots at rest.
WEST_POCKET_ENCRYPTION_KEY=
WEST_POCKET_MOBILE_URL=http://localhost:3001
# PRIVATE COS bucket; an existing private bucket may use the isolated west-pocket/ prefix.
# Never expose that prefix through the public product-image CDN.
WEST_POCKET_COS_BUCKET_URL=
WEST_POCKET_COS_SECRET_ID=
WEST_POCKET_COS_SECRET_KEY=
# Tencent Cloud IAI (2018-03-01 API, model 3.0 personnel group).
WEST_POCKET_IAI_SECRET_ID=
WEST_POCKET_IAI_SECRET_KEY=
WEST_POCKET_IAI_REGION=ap-shanghai
WEST_POCKET_IAI_GROUP_ID=
# Initial similarity policy; calibrate with consented local samples before release.
WEST_POCKET_FACE_THRESHOLD=85
WEST_POCKET_FACE_MARGIN=5
